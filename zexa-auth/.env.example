# Better Auth Configuration
BETTER_AUTH_SECRET=your-better-secret-key
BETTER_AUTH_URL=http://localhost:3000

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

DATABASE_URL=postgresql://your-database-user:your-database-password@your-database-host/your-database-name?sslmode=require

RESEND_API_KEY=your-resend-api-key

# ---------------------------------------------------------------------------
# HUDHUD M-04 — Back-to-CONTROL link (optional)
# URL of the HUDHUD CONTROL portal. When set, a "Back to CONTROL" button
# appears in the admin header; when unset it is hidden entirely (no fallback).
# HUDHUD_CONTROL_URL=https://control.hudhud.example

# ---------------------------------------------------------------------------
# HUDHUD Identity — OIDC provider (Phase A, staging opt-in)
# Leave these unset to keep zexa-auth exactly as before (no OIDC endpoints).
# Set HUDHUD_IDENTITY_ENABLED=true in staging only. Production activation
# requires a separate explicit approval.
# ---------------------------------------------------------------------------
# HUDHUD_IDENTITY_ENABLED=true
# HUDHUD_OIDC_ISSUER=https://auth.hudhud.example
# HUDHUD_OIDC_CLIENTS=[{"clientId":"example-app","clientSecret":"replace-from-secret-store","redirectURIs":["https://app.example/callback"]}]
