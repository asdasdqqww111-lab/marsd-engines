# ╔═══════════════════════════════════════════════════════╗
# ║   HUDHUD CONTROL — Environment Configuration Template    ║
# ╠═══════════════════════════════════════════════════════╣
# ║ نطاق البوابة: hudhud_core فقط — لا وصول لقواعد التطبيقات. ║
# ║ الأسرار تُدار عبر secret manager؛ لا تلتزم في Git أبدًا.    ║
# ╚═══════════════════════════════════════════════════════╝

# ── hudhud_core database (required) ─────────────────────
DATABASE_URL=postgresql://hudhud_core_user:CHANGE_ME@localhost:5432/hudhud_core

# ── Better Auth (required) ──────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_WITH_openssl_rand_base64_32

# Base URL where the portal is served (set in deployment)
BETTER_AUTH_URL=http://localhost:3000

# ── Application URLs (optional — health checks) ────────
# When unset the dashboard shows "unknown" — that is honest behavior,
# not an error. Never commit real internal addresses here.
HUDHUD_APP_MAPS_URL=
HUDHUD_APP_NEWS_URL=
HUDHUD_APP_VERIFY_URL=
HUDHUD_APP_IDENTITY_URL=
HUDHUD_APP_CONNECT_URL=
HUDHUD_APP_COMMUNITY_URL=
HUDHUD_APP_ANALYTICS_URL=
